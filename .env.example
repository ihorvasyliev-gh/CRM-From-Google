# Copy this file to frontend/.env and fill in your Supabase credentials
# These values are set as Environment Variables in Cloudflare Pages (never commit real values)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: public VAPID key for web push, if you generate your own key pair
# (must match the send-push-notification Edge Function's VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY secrets)
# VITE_VAPID_PUBLIC_KEY=
